  "classification_rules": {
    "output_activation": "sigmoid (BCEWithLogitsLoss during training; sigmoid applied at inference)",
    "prediction_decision_rule": {
      "description": "A label is assigned if its probability >= threshold. If no label reaches the threshold, keep the single top-1 (argmax) label so every molecule receives at least one label.",
      "threshold": 0.5,
      "comparator": ">=",
      "fallback": "argmax / top-1 when all probabilities < threshold",
      "threshold_selection_rationale": {
        "primary": "Fixed default of 0.5 for sigmoid multi-label outputs (standard decision boundary for BCEWithLogitsLoss + sigmoid).",
        "selection_criterion_for_released_checkpoint": "Among 5 CV folds, choose the fold with the highest validation macro-F1; that fold checkpoint is released. Threshold itself was not tuned per class or per fold.",
        "not_used": "No per-label threshold tuning (Youden / PR sweep) for released models."
      },
      "source_file": "src/data_utils.py",
      "source_file_sha256": "4861c54354a4f9678e37de8f673304ff08c8d1dd053a027cc2f957ece67b85f7",
      "decision_function": "src.data_utils.probs_to_multilabel_preds",
      "applies_to": [
        "src.data_utils.probs_to_multilabel_preds",
        "src.predict.make_predictions",
        "src.train.evaluate_on_loader",
        "scripts.eval_external.predict_level"
      ]
    },
    "notes": [
      "Released inference/evaluation uses probability threshold >= 0.5 with top-1 fallback via src.data_utils.probs_to_multilabel_preds."
    ]
  },
